{
	email {$ACME_EMAIL}
}

{$NTFY_DOMAIN} {
	encode gzip

	# ntfy's phone app holds a long-lived streaming connection for instant
	# delivery. A proxy that buffers or times that out turns "instant" into
	# "whenever the phone next polls", which is the one thing this server
	# exists to avoid - so the read timeout is disabled for the stream and
	# flush_interval -1 stops Caddy buffering the event stream.
	reverse_proxy ntfy:80 {
		flush_interval -1
		header_up X-Forwarded-For {remote_host}
		transport http {
			read_timeout 0
		}
	}

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		-Server
	}

	log {
		output stdout
		format console
	}
}
