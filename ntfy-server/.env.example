# Copy to .env and fill in. .env is gitignored - it holds passwords.

# The hostname the phones will use. The DNS A record must already point at this
# server before deploying, or Let's Encrypt fails and can rate-limit the domain.
NTFY_DOMAIN=CHANGE_ME.grameencybernet.net

# Where Let's Encrypt sends expiry warnings.
ACME_EMAIL=CHANGE_ME@example.com

# The topic the Ping Monitor publishes to. With auth-default-access=deny-all the
# name is not a secret any more, so it can be readable: gcl-ping-alerts.
NTFY_TOPIC=gcl-ping-alerts

# Two accounts, least privilege. Generate them, do not type them:
#   openssl rand -base64 24
NTFY_MONITOR_PASS=CHANGE_ME
NTFY_PHONE_PASS=CHANGE_ME
