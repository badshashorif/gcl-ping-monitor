# Copy to .env and fill in. .env is gitignored - it holds passwords.

# The hostname the phones will use. The DNS record must already point at this
# server before deploying, or Let's Encrypt fails and can rate-limit the domain.
NTFY_DOMAIN=CHANGE_ME.grameencybernet.net

# The topic the Ping Monitor publishes to. With auth-default-access=deny-all
# the name is not a secret any more, so it can be readable.
NTFY_TOPIC=gcl-ping-alerts

# Two accounts, least privilege. Generate them, do not type them:
#   openssl rand -base64 24
NTFY_MONITOR_PASS=CHANGE_ME
NTFY_PHONE_PASS=CHANGE_ME

# The docker network the host's existing Caddy is on. Leave blank and deploy.sh
# detects it and writes it back here. VERIFY rather than assume: on
# monitor.grameencybernet.net it is plain "monitor_net", not the
# "monitoring-stack_monitor_net" that Compose's project prefixing implies.
NTFY_NET_NAME=

TZ=Asia/Dhaka
