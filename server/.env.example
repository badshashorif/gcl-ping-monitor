# Copy to .env, fill in, then: chmod 600 .env
# Secrets live ONLY here - config.yml never holds a password, so the file people
# actually edit is safe to read over someone's shoulder.

# The dashboard access token. Generate one, do not invent one:
#   openssl rand -hex 16
# Leave it empty ONLY if the dashboard is unreachable from anywhere but this box.
GCLPM_WEB_TOKEN=CHANGE_ME

# SMTP password for the account in config.yml -> notify.email.user
GCLPM_EMAIL_PASSWORD=

# Telegram bot token from @BotFather (the chat id goes in config.yml)
GCLPM_TELEGRAM_TOKEN=

# Only for a self-hosted ntfy with authentication. Blank for public ntfy.sh.
GCLPM_NTFY_TOKEN=

# The real name of the monitoring-stack network. CHECK IT FIRST:
#   docker network ls | grep monitor
MONITOR_NET_NAME=monitoring-stack_monitor_net

TZ=Asia/Dhaka

# The ntfy topic. On the public ntfy.sh the topic name IS the password, so it
# can live here instead of in config.yml. Set either, not both - this one wins.
GCLPM_NTFY_TOPIC=
